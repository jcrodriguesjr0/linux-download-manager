{
  "manifest_version": 3,
  "name": "Linux Download Manager - Integração",
  "short_name": "LDM",
  "version": "1.4.0",
  "description": "Captura downloads e vídeos (YouTube e qualquer site) para o Linux Download Manager.",
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "webRequest",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Linux Download Manager",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ldm@linux-download-manager",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page_hook.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true
    }
  ]
}